{
  "name": "skintel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 8080",
    "dev:https": "SKINTEL_HTTPS=1 vite --host --port 8080",
    "build": "vite build && tsc --noEmit",
    "build:prov": "vite build --mode prov",
    "preview": "vite preview --host --port 8080",
